// Good Deeds — database schema.
// Models are PascalCase in code and snake_case in Postgres (@@map / @map).
// After changing this file run `pnpm db:migrate` (creates a migration + regenerates the client).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Category {
  environment
  animals
  education
  humanity
  charity
  community
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DeedStatus {
  PUBLISHED
  HIDDEN // hidden by moderation, still visible to its author
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  RIPPLE
  HELP_OFFER
  CHALLENGE
  CONFIRMATION
  VOUCH
  MILESTONE
}

enum HelpRequestStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum CircleRole {
  MEMBER
  ADMIN
}

enum ReportTarget {
  DEED
  COMMENT
  USER
  HELP_REQUEST
}

enum ReportReason {
  SPAM
  FAKE
  SELF_PROMOTION
  INAPPROPRIATE
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ───────────────────────── People ─────────────────────────

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Firebase Auth uid — the only link between auth and our data.
  firebaseUid String     @unique @map("firebase_uid")
  email       String     @unique
  /// Null until the person finishes onboarding (picks a username).
  username    String?    @unique
  name        String
  bio         String     @default("")
  location    String     @default("")
  avatarUrl   String?    @map("avatar_url")
  coverUrl    String?    @map("cover_url")
  interests   Category[]
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  onboardedAt DateTime?  @map("onboarded_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  deeds              Deed[]                 @relation("DeedAuthor")
  likes              Like[]
  saves              Save[]
  comments           Comment[]
  following          Follow[]               @relation("Follower")
  followers          Follow[]               @relation("Following")
  notifications      Notification[]         @relation("NotificationRecipient")
  sentNotifications  Notification[]         @relation("NotificationActor")
  challengesJoined   ChallengeParticipant[]
  challengesCreated  Challenge[]
  helpRequests       HelpRequest[]
  helpOffers         HelpOffer[]
  circlesCreated     Circle[]
  circleMemberships  CircleMember[]
  vouchesGiven       Vouch[]                @relation("Voucher")
  vouchesReceived    Vouch[]                @relation("Vouched")
  confirmations      DeedConfirmation[]
  reports            Report[]               @relation("Reporter")
  reportsResolved    Report[]               @relation("Resolver")
  deviceTokens       DeviceToken[]
  blocking           Block[]                @relation("Blocker")
  blockedBy          Block[]                @relation("Blocked")

  @@map("users")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

/// "I know this person does real good" — the trust signal behind verified doers.
model Vouch {
  voucherId String   @map("voucher_id") @db.Uuid
  vouchedId String   @map("vouched_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  voucher User @relation("Voucher", fields: [voucherId], references: [id], onDelete: Cascade)
  vouched User @relation("Vouched", fields: [vouchedId], references: [id], onDelete: Cascade)

  @@id([voucherId, vouchedId])
  @@index([vouchedId])
  @@map("vouches")
}

// ───────────────────────── Deeds ─────────────────────────

model Deed {
  id              String     @id @default(uuid(7)) @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  title           String
  description     String
  category        Category
  location        String?
  /// The day the good deed happened.
  activityDate    DateTime   @map("activity_date") @db.Date
  /// The deed that inspired this one (a "ripple").
  inspiredById    String?    @map("inspired_by_id") @db.Uuid
  challengeId     String?    @map("challenge_id") @db.Uuid
  /// Contribution towards the challenge goal, in the challenge's unit.
  challengeAmount Int?       @map("challenge_amount")
  status          DeedStatus @default(PUBLISHED)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  author        User               @relation("DeedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  inspiredBy    Deed?              @relation("Ripple", fields: [inspiredById], references: [id], onDelete: SetNull)
  ripples       Deed[]             @relation("Ripple")
  challenge     Challenge?         @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  images        DeedImage[]
  likes         Like[]
  saves         Save[]
  comments      Comment[]
  confirmations DeedConfirmation[]
  notifications Notification[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([inspiredById])
  @@index([challengeId])
  @@map("deeds")
}

model DeedImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  deedId      String   @map("deed_id") @db.Uuid
  /// Path inside the storage bucket, e.g. users/<uid>/deeds/<file>.webp
  storagePath String   @map("storage_path")
  url         String
  width       Int?
  height      Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  deed Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)

  @@index([deedId, position])
  @@map("deed_images")
}

model Like {
  deedId    String   @map("deed_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  deed Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deedId, userId])
  @@index([userId])
  @@map("likes")
}

model Save {
  deedId    String   @map("deed_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  deed Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deedId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saves")
}

model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  deedId    String    @map("deed_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  text      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  deed   Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([deedId, createdAt])
  @@map("comments")
}

/// "I was there" — someone confirms they saw or joined the deed.
model DeedConfirmation {
  deedId    String   @map("deed_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  deed Deed @relation(fields: [deedId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([deedId, userId])
  @@map("deed_confirmations")
}

// ───────────────────────── Community ─────────────────────────

model Challenge {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  title       String
  tagline     String
  description String
  category    Category
  coverUrl    String?  @map("cover_url")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  goal        Int
  /// Plural unit label, e.g. "meals", "trees", "kg of plastic".
  unit        String
  ideas       String[]
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants ChallengeParticipant[]
  deeds        Deed[]

  @@index([startDate, endDate])
  @@map("challenges")
}

model ChallengeParticipant {
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  joinedAt    DateTime @default(now()) @map("joined_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

model HelpRequest {
  id            String            @id @default(uuid(7)) @db.Uuid
  authorId      String            @map("author_id") @db.Uuid
  title         String
  description   String
  category      Category
  location      String
  neededBy      DateTime          @map("needed_by") @db.Date
  helpersNeeded Int               @map("helpers_needed")
  imageUrl      String?           @map("image_url")
  status        HelpRequestStatus @default(OPEN)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  offers        HelpOffer[]
  notifications Notification[]

  @@index([status, neededBy])
  @@map("help_requests")
}

model HelpOffer {
  requestId String   @map("request_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  request HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
  @@map("help_offers")
}

/// A neighbourhood or friend group of doers.
model Circle {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  location    String   @default("")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members   CircleMember[]

  @@map("circles")
}

model CircleMember {
  circleId String     @map("circle_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     CircleRole @default(MEMBER)
  joinedAt DateTime   @default(now()) @map("joined_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@index([userId])
  @@map("circle_members")
}

// ───────────────────────── System ─────────────────────────

model Notification {
  id            String           @id @default(uuid(7)) @db.Uuid
  recipientId   String           @map("recipient_id") @db.Uuid
  actorId       String?          @map("actor_id") @db.Uuid
  type          NotificationType
  deedId        String?          @map("deed_id") @db.Uuid
  helpRequestId String?          @map("help_request_id") @db.Uuid
  message       String?
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  recipient   User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  deed        Deed?        @relation(fields: [deedId], references: [id], onDelete: Cascade)
  helpRequest HelpRequest? @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Report {
  id           String       @id @default(uuid(7)) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetType   ReportTarget @map("target_type")
  targetId     String       @map("target_id") @db.Uuid
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  reporter   User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@map("reports")
}

/// Push notification tokens (FCM) for the mobile apps.
model DeviceToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
