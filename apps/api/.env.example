PORT=4100
NODE_ENV=development
DATABASE_URL="postgresql://gooddeeds:gooddeeds@localhost:5432/gooddeeds"
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000"

# Firebase — locally everything points at the emulators (no real project needed).
# A project id starting with "demo-" tells Firebase this is emulator-only.
FIREBASE_PROJECT_ID="demo-good-deeds"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
# Production only: service account JSON (base64). Leave empty locally / on Cloud Run (uses ADC).
FIREBASE_SERVICE_ACCOUNT_BASE64=""
# Comma-separated emails that get the ADMIN role on first sign-in.
ADMIN_EMAILS=""
