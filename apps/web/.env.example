# Phase 2 — the web app talks to the local API and Firebase emulators.
NEXT_PUBLIC_API_URL="http://localhost:4100/v1"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="demo-good-deeds"
NEXT_PUBLIC_FIREBASE_API_KEY="demo-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="demo-good-deeds.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="demo-good-deeds.appspot.com"
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="true"
